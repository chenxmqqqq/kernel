/*
 * Copyright (c) 2024 Rockchip Electronics Co., Ltd.
 * Copyright (c) 2025 Radxa Computer (Shenzhen) Co., Ltd.
 *
 * Custom carrier for an unmodified Radxa CM3, pin requirements revision 2.
 * GPIO0_B1/B2 are the module's PMIC I2C bus and GPIO0_A2 is PMIC_SLEEP.
 * OTG VBUS enable and SYS_LED1/2 are wired to TCA9534 P0/P1/P2 on I2C1.
 */

/dts-v1/;

#include "rk3566-radxa-cm3.dtsi"

/delete-node/ &gpio_leds;
/delete-node/ &user_led_set;

/ {
	model = "Radxa CM3 IO Board";
	compatible = "radxa,cm3-io", "radxa,cm3", "rockchip,rk3566";

	aliases {
		rtc0 = &hym8563;
	};

	beeper {
		compatible = "pwm-beeper";
		pwms = <&pwm4 0 500000 0>;
	};

	hdmi_sound: hdmi-sound {
		compatible = "rockchip,hdmi";
		rockchip,mclk-fs = <128>;
		rockchip,card-name = "rockchip-hdmi";
		rockchip,cpu = <&i2s0_8ch>;
		rockchip,codec = <&hdmi>;
		rockchip,jack-det;
	};

	leds {
		compatible = "gpio-leds";

		led-1 {
			label = "SYS_LED1";
			gpios = <&tca9534 1 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led-2 {
			label = "SYS_LED2";
			gpios = <&tca9534 2 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	/* SD power switch polarity follows the supplied RC119 reference. */
	vcc_sd: sdmmc-regulator {
		compatible = "regulator-fixed";
		gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&sdmmc_pwren>;
		regulator-name = "vcc_sd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <100000>;
		vin-supply = <&vcc3v3_sys>;
	};

	vcc5v0_otg: vcc5v0-otg-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&tca9534 0 GPIO_ACTIVE_HIGH>;
		regulator-name = "vcc5v0_otg";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc5v0_usb2: vcc5v0-usb2-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio4 RK_PC5 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb2_power_en>;
		regulator-name = "vcc5v0_usb2";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc5v0_usb3: vcc5v0-usb3-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb3_power_en>;
		regulator-name = "vcc5v0_usb3";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_sys>;
	};

	watchdog-gpio {
		compatible = "linux,wdt-gpio";
		gpios = <&gpio4 RK_PB7 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&watchdog_pin>;
		hw_algo = "toggle";
		hw_margin_ms = <1000>;
		timeout-sec = <1>;
		/* Keep servicing WDI even when no userspace client is open. */
		always-running;
	};

	wireless_wlan: wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <&grf>;
		wifi_chip_type = "cm256sm";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake_l>;
		WIFI,host_wake_irq = <&gpio2 RK_PC1 IRQ_TYPE_LEVEL_HIGH>;
		status = "okay";
	};
};

&combphy1_usq {
	status = "okay";
};

&combphy2_psq {
	status = "okay";
};

&display_subsystem {
	status = "okay";
};

&hdmi {
	preset_max_hdisplay = <1920>;
	preset_max_vdisplay = <1080>;
	preset_as_preferred;
	status = "okay";
};

&hdmi_in_vp0 {
	status = "okay";
};

&hdmi_in_vp1 {
	status = "disabled";
};

&i2c1 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_xfer>;
	status = "okay";

	tca9534: gpio@20 {
		/* TCA9534 uses the PCA9534 register layout. */
		compatible = "nxp,pca9534";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names = "TCA9534_P0", "TCA9534_P1",
				  "TCA9534_P2", "TCA9534_P3",
				  "TCA9534_P4", "TCA9534_P5",
				  "TCA9534_P6", "TCA9534_P7";
		status = "okay";
	};
};

&i2c2 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2m1_xfer>;
	status = "okay";

	hym8563: rtc@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		#clock-cells = <0>;
		clock-output-names = "hym8563";
		/* INT is wired to PWRON_KEY, not a SoC interrupt input. */
	};

	/* ATECC608A at 0x60 is accessed by userspace through /dev/i2c-2. */
};

&i2s0_8ch {
	status = "okay";
};

&i2s1_8ch {
	status = "disabled";
};

&pcie2x1 {
	/* This BSP drives logical 0 to assert PERST# and 1 to release it. */
	reset-gpios = <&gpio1 RK_PB2 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_sys>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie_reset_pin>;
	/* CLKREQ# and WAKE# remain GPIO inputs; do not enable supports-clkreq. */
	status = "okay";
};

&pwm4 {
	pinctrl-names = "default", "active";
	pinctrl-0 = <&beeper_idle>;
	pinctrl-1 = <&pwm4_pins>;
	status = "okay";
};

&rk817 {
	rtc {
		status = "disabled";
	};
};

&rk817_codec {
	status = "disabled";
};

&route_hdmi {
	connect = <&vp0_out_hdmi>;
	status = "okay";
};

&sdmmc0 {
	max-frequency = <150000000>;
	supports-sd;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc_sd>;
	vqmmc-supply = <&vccio_sd>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
	status = "okay";
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0m0_tx_only>;
	/delete-property/ pinctrl-1;
	num-cs = <1>;
	status = "okay";

	/* RFSA3513: userspace pulses LE after writing; no CS pad is muxed. */
	spidev@0 {
		compatible = "rockchip,spidev";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

&spi1 {
	pinctrl-names = "default", "high_speed";
	pinctrl-0 = <&spi1m1_cs0 &spi1m1_pins>;
	pinctrl-1 = <&spi1m1_cs0_hs &spi1m1_pins_hs>;
	num-cs = <1>;
	status = "okay";

	spidev@0 {
		compatible = "rockchip,spidev";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

&spi3 {
	pinctrl-names = "default", "high_speed";
	pinctrl-0 = <&spi3m0_cs0 &spi3m0_pins>;
	pinctrl-1 = <&spi3m0_cs0_hs &spi3m0_pins_hs>;
	num-cs = <1>;
	status = "okay";

	spidev@0 {
		compatible = "rockchip,spidev";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

&threshold {
	temperature = <60000>;
};

&u2phy0_host {
	phy-supply = <&vcc5v0_usb3>;
	status = "okay";
};

&u2phy0_otg {
	vbus-supply = <&vcc5v0_otg>;
	status = "okay";
};

&u2phy1_otg {
	phy-supply = <&vcc5v0_usb2>;
	status = "okay";
};

&u2phy1_host {
	status = "okay";
};

&uart7 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart7m2_xfer>;
	status = "okay";
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

&usbdrd_dwc3 {
	dr_mode = "otg";
};

&usbhost30 {
	status = "okay";
};

&usbhost_dwc3 {
	status = "okay";
};

&pinctrl {
	/* Set initial levels without gpio-hogs, leaving application lines free. */
	pinctrl-names = "default";
	pinctrl-0 = <&carrier_outputs_low &carrier_outputs_high
		     &carrier_inputs &carrier_inputs_up &carrier_inputs_down
		     &tf_det_disable>;

	carrier_input: carrier-input {
		bias-pull-down;
		input-enable;
	};

	carrier_input_up: carrier-input-up {
		bias-pull-up;
		input-enable;
	};

	carrier_input_down: carrier-input-down {
		bias-pull-down;
		input-enable;
	};

	beeper {
		beeper_idle: beeper-idle {
			rockchip,pins = <0 RK_PC3 RK_FUNC_GPIO &pcfg_output_low_pull_none>;
		};
	};

	carrier {
		carrier_outputs_low: carrier-outputs-low {
			rockchip,pins =
				<3 RK_PB4 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* RX_ATT_SEL */
				<0 RK_PD5 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* GPIO1_RX_SEL */
				<0 RK_PD6 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* LO_ATT_SEL */
				<2 RK_PC6 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* RX_SEL_1 */
				<0 RK_PD3 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* RX_SEL_2 */
				<4 RK_PC6 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* RX_SEL_3 */
				<1 RK_PA4 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* ANT_SEL_1 */
				<1 RK_PA1 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* ANT_SEL_2 */
				<1 RK_PA0 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* ANT_SEL_3 */
				<3 RK_PD6 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* PWR_EN */
				<0 RK_PC4 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* POWER_EN */
				<4 RK_PC1 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* SYS_LED3 */
				<4 RK_PA4 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* GPIO_O1 */
				<0 RK_PC2 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* GPIO_O2 */
				<3 RK_PD1 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* GPIO_O3 */
				<3 RK_PD0 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* GPIO_O4 */
				<3 RK_PD2 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* GPIO_O5 */
				<4 RK_PA7 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* GPIO_O6 */
				<0 RK_PC5 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* GPIO_O7 */
				<4 RK_PC0 RK_FUNC_GPIO &pcfg_output_low_pull_none>, /* GPIO_O8 */
				<0 RK_PC6 RK_FUNC_GPIO &pcfg_output_low_pull_none>; /* LE */
		};

		carrier_outputs_high: carrier-outputs-high {
			rockchip,pins =
				<4 RK_PA1 RK_FUNC_GPIO &pcfg_output_high_pull_none>; /* E710_ENABLE */
		};

		carrier_inputs: carrier-inputs {
			rockchip,pins =
				<4 RK_PB1 RK_FUNC_GPIO &carrier_input>, /* GPIO_IN1 */
				<3 RK_PC6 RK_FUNC_GPIO &carrier_input>, /* GPIO_IN2 */
				<3 RK_PD3 RK_FUNC_GPIO &carrier_input>, /* GPIO_IN3 */
				<3 RK_PD4 RK_FUNC_GPIO &carrier_input>, /* GPIO_IN4 */
				<0 RK_PB7 RK_FUNC_GPIO &carrier_input>, /* GPIO_IN5 */
				<0 RK_PC7 RK_FUNC_GPIO &carrier_input>, /* GPIO_IN6 */
				<3 RK_PC7 RK_FUNC_GPIO &carrier_input>, /* GPIO_IN7 */
				<3 RK_PD5 RK_FUNC_GPIO &carrier_input>; /* GPIO_IN8 */
		};

		carrier_inputs_up: carrier-inputs-up {
			rockchip,pins =
				<4 RK_PC4 RK_FUNC_GPIO &carrier_input_up>, /* ANT_DET */
				<3 RK_PD7 RK_FUNC_GPIO &carrier_input_up>, /* READY_N */
				<4 RK_PA0 RK_FUNC_GPIO &carrier_input_up>, /* E710_RESET_N */
				<0 RK_PC1 RK_FUNC_GPIO &carrier_input_up>, /* IRQ_N */
				<1 RK_PB0 RK_FUNC_GPIO &carrier_input_up>, /* PCIE_CLKREQ_N */
				<1 RK_PB1 RK_FUNC_GPIO &carrier_input_up>; /* PCIE_WAKE_N */
		};

		carrier_inputs_down: carrier-inputs-down {
			rockchip,pins =
				<4 RK_PB6 RK_FUNC_GPIO &carrier_input_down>, /* RESET */
				<4 RK_PA5 RK_FUNC_GPIO &carrier_input_down>; /* BUTTON */
		};
	};

	gmac1 {
		gmac1m0_miim: gmac1m0-miim {
			rockchip,pins =
				/* gmac1_mdcm0 */
				<3 RK_PC4 3 &pcfg_pull_none_drv_level_15>,
				/* gmac1_mdiom0 */
				<3 RK_PC5 3 &pcfg_pull_none_drv_level_15>;
		};

		gmac1m0_rx_bus2: gmac1m0-rx-bus2 {
			rockchip,pins =
				/* gmac1_rxd0m0 */
				<3 RK_PB1 3 &pcfg_pull_none_drv_level_15>,
				/* gmac1_rxd1m0 */
				<3 RK_PB2 3 &pcfg_pull_none_drv_level_15>,
				/* gmac1_rxdvcrsm0 */
				<3 RK_PB3 3 &pcfg_pull_none_drv_level_15>;
		};

		gmac1m0_tx_bus2: gmac1m0-tx-bus2 {
			rockchip,pins =
				/* gmac1_txd0m0 */
				<3 RK_PB5 3 &pcfg_pull_none_drv_level_15>,
				/* gmac1_txd1m0 */
				<3 RK_PB6 3 &pcfg_pull_none_drv_level_15>,
				/* gmac1_txenm0 */
				<3 RK_PB7 3 &pcfg_pull_none_drv_level_15>;
		};

		gmac1m0_rgmii_clk: gmac1m0-rgmii-clk {
			rockchip,pins =
				/* gmac1_rxclkm0 */
				<3 RK_PA7 3 &pcfg_pull_none_drv_level_15>,
				/* gmac1_txclkm0 */
				<3 RK_PA6 3 &pcfg_pull_none_drv_level_15>;
		};

		gmac1m0_rgmii_bus: gmac1m0-rgmii-bus {
			rockchip,pins =
				/* gmac1_rxd2m0 */
				<3 RK_PA4 3 &pcfg_pull_none_drv_level_15>,
				/* gmac1_rxd3m0 */
				<3 RK_PA5 3 &pcfg_pull_none_drv_level_15>,
				/* gmac1_txd2m0 */
				<3 RK_PA2 3 &pcfg_pull_none_drv_level_15>,
				/* gmac1_txd3m0 */
				<3 RK_PA3 3 &pcfg_pull_none_drv_level_15>;
		};

		gmac1m0_clkinout: gmac1m0-clkinout {
			rockchip,pins =
				/* gmac1_mclkinoutm0 */
				<3 RK_PC0 3 &pcfg_pull_none_drv_level_15>;
		};
	};

	pcie {
		pcie_reset_pin: pcie-reset-pin {
			rockchip,pins = <1 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	sdcard {
		sdmmc_pwren: sdmmc-pwren {
			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		tf_det_disable: tf-det-disable {
			rockchip,pins = <0 RK_PD4 RK_FUNC_GPIO &pcfg_output_low_pull_none>;
		};
	};

	spi0 {
		spi0m0_tx_only: spi0m0-tx-only {
			rockchip,pins = <0 RK_PB5 2 &pcfg_pull_none>,
				       <0 RK_PB6 2 &pcfg_pull_none>;
		};
	};

	usb {
		usb2_power_en: usb2-power-en {
			rockchip,pins = <4 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		usb3_power_en: usb3-power-en {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	watchdog {
		watchdog_pin: watchdog-pin {
			rockchip,pins = <4 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};
